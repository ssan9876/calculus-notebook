{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calculus",
  "version": "2.0.0",
  "identifier": "app.calculus.notebook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Calculus",
      "width": 1440,
      "height": 940,
      "minWidth": 720,
      "minHeight": 560,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; worker-src 'self' blob:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https: wss:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "shortDescription": "Local-first computational notebook",
    "longDescription": "Calculus combines symbolic math, Python, rich outputs, and durable local notebooks.",
    "category": "Education",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
